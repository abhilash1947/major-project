{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE"
  },
  "services": {
    "backend-java": {
      "source": "backend-java",
      "healthcheck": "/api/v1/health"
    },
    "backend-python": {
      "source": "backend-python",
      "healthcheck": "/health"
    },
    "frontend-react": {
      "source": "frontend-react"
    }
  }
}
